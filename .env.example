# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/lead_enrichment

# Redis connection string (used as Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# OpenAI API key used for pitch generation
OPENAI_API_KEY=sk-your-openai-api-key

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
