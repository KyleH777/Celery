# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/lead_enrichment

# Redis connection string (used as Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# OpenAI API key used for pitch generation
OPENAI_API_KEY=sk-your-openai-api-key

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output

# Stripe billing (test-mode keys from https://dashboard.stripe.com/test/apikeys).
# For local webhooks: `stripe listen --forward-to localhost:8000/api/v1/billing/webhook`
# prints the whsec_... value to use below.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID=price_your-subscription-price-id
MONTHLY_LEAD_CREDITS=100

# Resend transactional email (https://resend.com/api-keys).
# Leave RESEND_API_KEY empty to disable email notifications.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM="ProspectGPT <notifications@yourdomain.com>"
DASHBOARD_URL=http://localhost:8501
